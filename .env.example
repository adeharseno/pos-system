# Public configuration used by Supabase Auth and approved Storage operations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never rename this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Trusted origin for employee invitations. Never derived from a request Host header.
APP_SITE_URL=http://127.0.0.1:3000
# Optional exact browser origins, comma separated (local development alias).
APP_ADDITIONAL_ORIGINS=http://localhost:3000
