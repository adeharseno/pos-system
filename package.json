{
  "name": "pharmacy-pos-pilot-1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local",
    "db:test": "supabase test db --local supabase/tests/database",
    "db:test:concurrency": "node supabase/tests/concurrency/core-rpc-concurrency.cjs",
    "test:data": "tsx --test src/modules/data-layer.test.ts",
    "test:auth": "tsx --test src/modules/auth/auth.test.ts",
    "test:api": "tsx --test src/modules/api.test.ts",
    "test:cashier": "tsx --test src/modules/cashier-cart.test.ts",
    "test:checkout": "tsx --test src/modules/checkout-payment.test.ts",
    "test:qris": "tsx --test src/modules/qris-payment.test.ts",
    "test:receipt": "tsx --test src/modules/receipt.test.ts",
    "test:history": "tsx --test src/modules/transaction-history.test.ts",
    "test:returns": "tsx --test src/modules/returns/return-quantity.test.ts",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.108.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "pg": "^8.23.0",
    "supabase": "2.114.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  }
}
